{
  "rewrites": [
    { "source": "/client", "destination": "/quicbizz_client.html" },
    { "source": "/client/", "destination": "/quicbizz_client.html" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/", "statusCode": 404 },
    { "source": "/admin/", "destination": "/", "statusCode": 404 }
  ],
  "headers": [
    {
      "source": "/quicbizz_staff_admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
